{
  "name": "bug-bench-ts",
  "version": "1.0.0",
  "description": "TypeScript vulnerable API handler for cygent-bug-bench",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/api-handler.js",
    "dev": "tsx api-handler.ts",
    "lint": "eslint \"**/*.ts\"",
    "lint:fix": "eslint \"**/*.ts\" --fix",
    "format": "prettier \"**/*.ts\" --write",
    "format:check": "prettier \"**/*.ts\" --check"
  },
  "dependencies": {
    "express": "4.21.2",
    "jsonwebtoken": "9.0.2",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/pg": "8.11.11",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.0",
    "prettier": "^3.4.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
